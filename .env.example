DEEP_INFRA_API_KEY=sk-di-your-key-here

# Backlog storage. Defaults to neo4j when NEO4J_URI is set; use sqlite only for tests.
# BACKLOG_STORE=neo4j
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j

# VS Code workspace. The IDE runs separately with compose.ide.yaml.
# The workspace is a fresh Docker volume; clone or copy repos inside the IDE.
# IDE_URL=http://127.0.0.1:8080
# IDE_INTERNAL_URL=http://host.docker.internal:8080
# IDE_PORT=8080
# IDE_VOLUME=forge-ide_workspace-data
# IDE_WORKSPACE_NAME=Forge IDE
