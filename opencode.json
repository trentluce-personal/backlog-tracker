{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-6.1-sol",
  "autoupdate": false,
  "default_agent": "dispatcher",
  "enabled_providers": ["github-copilot", "deepinfra"],
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "rm *": "ask"
  }
}
