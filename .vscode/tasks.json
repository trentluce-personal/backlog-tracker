{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start application",
      "type": "process",
      "command": "/bin/sh",
      "args": ["${workspaceFolder}/scripts/application.sh", "Start"],
      "windows": {
        "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\application.ps1", "-Action", "Start"]
      },
      "osx": { "command": "/bin/sh", "args": ["${workspaceFolder}/scripts/application.sh", "Start"] },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "Stop application",
      "type": "process",
      "command": "/bin/sh",
      "args": ["${workspaceFolder}/scripts/application.sh", "Stop"],
      "windows": {
        "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\application.ps1", "-Action", "Stop"]
      },
      "osx": { "command": "/bin/sh", "args": ["${workspaceFolder}/scripts/application.sh", "Stop"] },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "Restart application",
      "type": "process",
      "command": "/bin/sh",
      "args": ["${workspaceFolder}/scripts/application.sh", "Restart"],
      "windows": {
        "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\application.ps1", "-Action", "Restart"]
      },
      "osx": { "command": "/bin/sh", "args": ["${workspaceFolder}/scripts/application.sh", "Restart"] },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "View application logs",
      "type": "process",
      "command": "/bin/sh",
      "args": ["${workspaceFolder}/scripts/application.sh", "Logs"],
      "windows": {
        "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\application.ps1", "-Action", "Logs"]
      },
      "osx": { "command": "/bin/sh", "args": ["${workspaceFolder}/scripts/application.sh", "Logs"] },
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    }
  ]
}
